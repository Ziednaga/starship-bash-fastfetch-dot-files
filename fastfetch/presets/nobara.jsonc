
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/presets/ascii-nobara.txt",
        "padding": {
            "top": 5,
            "right": 6
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
    	{
      	    "key": " Subject:",
            "type": "title",
            "format": "[{user-name}]",
            "keyColor": "#fab387"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;132;0m\u001b[1m☢ •◦ > ╾────────────╼ λ ╾──────────────╼\u001b[22m  \u001b[0m"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "#f9e2af",  // = color3
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#f9e2af",
        },
        {
            "type": "packages",
            "format": "{} (DNF)",
            "key": " ",
            "keyColor": "#f9e2af",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#f9e2af", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#f9e2af", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#f9e2af", 
        },
        {
            "type": "custom",
            "key": " ",
            "format": "Steam Linux Runtime",
            "keyColor": "#f9e2af",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "#f9e2af", 
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "#f9e2af", 
            "format": "{artist} - {title:-30}",
        },
        {
  "type": "colors",
  "paddingLeft": 0,
  "symbol": "circle",
  "block": {
    "width": 40
  }
},
        {
            "type": "custom",
            "format": "\u001b[38;2;255;132;0m\u001b[1m☢ •◦ > ╾────────────╼ 3 ╾──────────────╼\u001b[22m  \u001b[0m"
        },
        "break",
        "break",
    ]
}
